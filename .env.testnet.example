# Network
RPC_URL=https://your-testnet-rpc
CHAIN_ID=11155111
# Safety: mainnet deploy is blocked by default in scripts/deploy-testnet.sh.
# ALLOW_MAINNET_DEPLOY=1

# Deployer
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# --- yPot core deployment (DeployyPot.s.sol) ---
ASSET=0xYourAssetToken
VAULT=0xYourERC4626Vault
TREASURY=0xYourTreasury

# Oracle set (must be >= 2)
ORACLE_COUNT=2
ORACLE_0=0xYourOracle0
ORACLE_1=0xYourOracle1

# --- Base Sepolia public preview (MockUSDC + MockERC4626Vault + YearnWrapper) ---
# Used by scripts/deploy-preview.sh / script/DeployLocalStack.s.sol
# OUT=deployments/base-sepolia-preview.json
# WITH_UMA=true
# TREASURY can be omitted for preview and defaults to the deployer address
# ORACLE_0 can be omitted for preview and defaults to the deployer address
# FAUCET_CLAIM_AMOUNT=10000000000
# FAUCET_CLAIM_COOLDOWN=3600
# FAUCET_SEED_AMOUNT=100000000000000

# --- YearnWrapper deployment (DeployYearnWrapper.s.sol) ---
# YEARN_VAULT=0xYourYearnV3Vault
# DEPOSITOR_COUNT=1
# DEPOSITOR_0=0xYourYPotAddress

# --- UMA Optimistic Oracle Adapter (DeployUmaOptimisticOracleAdapter.s.sol) ---
# UMA_OPTIMISTIC_ORACLE=0xYourUmaOracleAddress
# CURRENCY=0xYourCurrencyToken
# UMA_IDENTIFIER=0xYourIdentifierBytes32
# UMA_LIVENESS=7200
# UMA_BOND=0
# UMA_REWARD=0
# REQUESTER_COUNT=1
# REQUESTER_0=0xYourUmaModuleAddress

# Optional verification
# ETHERSCAN_API_KEY=your_api_key
# VERIFIER_URL=
